# Cloudflare Workers static assets (and Netlify) read this file. Owner decisions 2026-11-15.
#
# Security headers for every response. The build (integrations/csp.ts) replaces
# the inline-script-hashes placeholder in the CSP with the sha256 of every inline script, so dist/_headers has the real CSP.
# Never put Cache-Control in this block: Cloudflare comma-joins a header set by two matching rules,
# which would break the /_astro/* rule below.
# static.cloudflareinsights.com and cloudflareinsights.com are for Cloudflare Web Analytics, which
# this deployment injects at the edge (owner decision 2026-11-15). Forks can drop them.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'inline-script-hashes' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Content-Security-Policy-Report-Only: require-trusted-types-for 'script'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()

# Files under /_astro/ have content hashes in their names, so they never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og-default.png
  Cache-Control: public, max-age=86400
