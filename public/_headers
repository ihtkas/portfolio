# Cloudflare Workers static assets (and Netlify) read this file. Owner decision 2026-11-15.
# Files under /_astro/ have content hashes in their names, so they never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og-default.png
  Cache-Control: public, max-age=86400
