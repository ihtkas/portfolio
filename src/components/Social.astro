---
import { site } from '../../site.config';

const { github, linkedin, email, rss } = site.socials;
const hello = email ? `mailto:${email}` : linkedin;
---

<div class="social">
  {github && (
    <a href={github} aria-label="GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
      </svg>
    </a>
  )}
  {linkedin && (
    <a href={linkedin} aria-label="LinkedIn">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M0 1.15C0 .52.52 0 1.15 0h13.7C15.48 0 16 .52 16 1.15v13.7c0 .63-.52 1.15-1.15 1.15H1.15C.52 16 0 15.48 0 14.85V1.15zM4.94 13.4V6.17H2.54v7.23h2.4zM3.74 5.18c.84 0 1.36-.56 1.36-1.25-.02-.71-.52-1.25-1.35-1.25-.82 0-1.36.54-1.36 1.25 0 .69.52 1.25 1.33 1.25h.02zm4.93 8.22V9.36c0-.22.02-.43.08-.59.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.64v3.87h2.4V9.26c0-2.22-1.18-3.25-2.76-3.25-1.28 0-1.84.7-2.16 1.2V6.17h-2.4c.03.68 0 7.23 0 7.23h2.4z" />
      </svg>
    </a>
  )}
  {rss && (
    <a href="/rss.xml" aria-label="RSS feed">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="2.5" cy="13.5" r="2.5" />
        <path d="M0 5.6a10.4 10.4 0 0110.4 10.4H8A8 8 0 000 8z" />
        <path d="M0 .8A15.2 15.2 0 0115.2 16h-2.4A12.8 12.8 0 000 3.2z" />
      </svg>
    </a>
  )}
  {hello && (
    <a href={hello} class="where">
      Say hello
    </a>
  )}
</div>
