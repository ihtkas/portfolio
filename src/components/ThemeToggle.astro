---
// Wired up by src/scripts/theme.ts. An inline script right after the button
// sets the label for the effective theme before first paint.
---

<button
  class="switch"
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  title="Dark / light"
>
  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
    <g class="sun">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </g>
    <path class="moon" d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"></path>
  </svg>
</button>
<script is:inline>
  {
    const b = document.currentScript.previousElementSibling;
    const t = document.documentElement.dataset.theme;
    const light = t ? t === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
    b.setAttribute('aria-label', 'Switch to ' + (light ? 'dark' : 'light') + ' theme');
  }
</script>

<script>
  import '../scripts/theme';
</script>
