---
import YearGroup from '../../components/YearGroup.astro';
import Base from '../../layouts/Base.astro';
import { loadResume } from '../../lib/resume';
import { site } from '../../../site.config';

const resume = loadResume();
---

<Base
  title={`Resume | ${site.name}`}
  description={`Experience, skills and education of ${site.name}.`}
  current="resume"
  wide
>
  <header class="intro split">
    <div>
      <h1 class="title">Resume</h1>
      <p class="who">
        <b>{site.name}</b>, {site.location}
      </p>
      <p class="lede summary">{resume.summary}</p>
      <div class="btns">
        {resume.pdf ? (
          <a class="btn solid" href={resume.pdf} download>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M7 1h2v7.6l2.6-2.6 1.4 1.4L8 12.4 3 7.4 4.4 6 7 8.6zM2 13h12v2H2z" />
            </svg>
            Download PDF
          </a>
        ) : (
          <button type="button" class="btn solid" data-print={`${site.name} Resume`}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M7 1h2v7.6l2.6-2.6 1.4 1.4L8 12.4 3 7.4 4.4 6 7 8.6zM2 13h12v2H2z" />
            </svg>
            Download PDF
          </button>
        )}
      </div>
    </div>
    <aside class="facts" aria-label="Skills and education">
      <div>
        <h2>Skills</h2>
        <dl>
          {Object.entries(resume.skills).map(([group, items]) => (
            <>
              <dt>{group}</dt>
              <dd>{items.join(', ')}</dd>
            </>
          ))}
        </dl>
      </div>
      <div>
        <h2>Education</h2>
        {resume.education.map((e) => (
          <div class="edu">
            <b>{e.school}</b>
            <span>
              {e.degree}, {e.years}
            </span>
          </div>
        ))}
      </div>
    </aside>
  </header>

  <div class="years">
    {resume.orgs.map((org, i) => (
      <YearGroup id={`r-${i}`} heading={org.name} sub={org.period}>
        <div>
          {org.roles.map((role) => (
            <article class="role">
              <h3>{role.title}</h3>
              <span class="when">{role.period}</span>
              {role.intro && <p class="about">{role.intro}</p>}
              <ul>
                {role.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </YearGroup>
    ))}
  </div>
</Base>

<script>
  // Opens the browser's print dialog ("Save as PDF"). The print stylesheet in base.css
  // turns the page into a plain document. The title becomes the suggested file name.
  const button = document.querySelector<HTMLButtonElement>('[data-print]');
  button?.addEventListener('click', () => {
    const previous = document.title;
    document.title = button.dataset.print ?? previous;
    window.addEventListener('afterprint', () => (document.title = previous), { once: true });
    window.print();
  });
</script>
