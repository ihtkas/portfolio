---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---

<Base title={`Page not found | ${site.name}`} description="This page does not exist." wide noindex>
  <header class="intro lost">
    <h1 class="title">Not found</h1>
    <p class="lede">That page is not here. It may have moved, or the link may be wrong.</p>
    <div class="btns">
      <a class="btn solid" href="/">
        Back home
      </a>
    </div>
  </header>
</Base>
