---
import '../styles/fonts';
import '../styles/tokens.css';
import '../styles/base.css';
import Footer from '../components/Footer.astro';
import Header, { type NavKey } from '../components/Header.astro';
import { site } from '../../site.config';
// Preloading the body and display fonts avoids a layout shift when they swap in.
import bodyFont from '../../node_modules/@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import displayFont from '../../node_modules/@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  current?: NavKey | undefined;
  wide?: boolean | undefined;
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
}

const {
  title,
  description,
  current,
  wide = false,
  noindex = false,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site.socials.rss && (
      <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    )}
    <slot name="head" />
    <script is:inline>
      {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch {
          // storage blocked: follow the system preference
        }
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header current={current} />
    <main id="main" class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
